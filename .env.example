# Database URL — local PostgreSQL (do not commit real credentials)
DATABASE_URL=postgresql://energyguard:energyguard_dev@localhost:5432/energyguard

# Auth
AUTH_PROVIDER=mock
AUTH_SESSION_SECRET=replace-with-32-plus-character-secret
SESSION_IDLE_MINUTES=480
APP_ORIGIN=http://localhost:3000
# Public HTTPS origin used by iPhone / TestFlight (set this when using a tunnel)
# CAPACITOR_SERVER_URL=https://your-host.trycloudflare.com
# Extra hosts the iOS app may open, comma-separated
# CAPACITOR_ALLOWED_HOSTS=*.example.com

# Microsoft Entra ID (production)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# Speech
SPEECH_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AUDIO_RETENTION_ENABLED=false

# AI
AI_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Evidence storage
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
MALWARE_SCAN_PROVIDER=none
RETAIN_PHOTO_LOCATION_METADATA=false

# Seed
SEED_PUBLISH_CONTROLLED_CONTENT=true
