{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "config": "development-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    },
    "production": {
      "ios": {
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID"
      }
    }
  }
}
