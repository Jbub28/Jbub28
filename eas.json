{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "config": "development-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1",
        "EXPO_APPLE_TEAM_ID": "L7ZVZDDF3G",
        "EXPO_APPLE_TEAM_TYPE": "COMPANY_OR_ORGANIZATION"
      }
    },
    "production": {
      "node": "22.23.1",
      "ios": {
        "image": "latest",
        "scheme": "App",
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1",
        "EXPO_APPLE_TEAM_ID": "L7ZVZDDF3G",
        "EXPO_APPLE_TEAM_TYPE": "COMPANY_OR_ORGANIZATION"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811939293",
        "appleTeamId": "L7ZVZDDF3G",
        "bundleIdentifier": "com.jbub28.energyguardjrb"
      }
    }
  }
}
