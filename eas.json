{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "config": "development-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    },
    "production": {
      "node": "22.23.1",
      "ios": {
        "image": "latest",
        "scheme": "App",
        "config": "production-ios.yml"
      },
      "env": {
        "CAPACITOR_BUILD": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811939293"
      }
    }
  }
}
