    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.110.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "mapbox-gl": "^3.25.0",
    "next": "16.2.10",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
